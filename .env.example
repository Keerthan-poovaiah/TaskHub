# Copy this file to ".env" and fill in real values.
# ".env" is never committed to Git. This example file IS committed.

# Postgres: either the "postgresql://user:password@host/database" address that Neon shows,
# or the "Host=...;Database=...;Username=...;Password=..." format.
POSTGRES_CONNECTION=Host=localhost;Port=5433;Database=taskhub;Username=taskhub;Password=taskhub_dev

# Redis: "host:port", or a "redis://..." address from a hosting provider.
REDIS_CONNECTION=localhost:6379

# A long random string (at least 32 characters). Used to sign login tickets.
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters

# From your Resend dashboard. Used by the worker to send emails.
RESEND_API_KEY=replace-me
EMAIL_FROM=TaskHub <onboarding@resend.dev>

# The website address(es) allowed to call the API from a browser. Separate several with commas.
UI_ORIGIN=http://localhost:5173

# "true" makes the API also run the worker, reaper, scheduler and sweeper inside itself
# (used on free hosting). Leave it "false" when you run those as separate programs.
RUN_BACKGROUND_SERVICES=false

# "false" stops the API from creating or updating the database tables at startup.
AUTO_MIGRATE=true